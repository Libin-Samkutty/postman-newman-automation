{
  "item": [
    {
      "id": "6e824d5f-d1e5-4513-a785-0769d2d397b8",
      "name": "Login - Valid Credentials",
      "request": {
        "description": {
          "content": "Authenticate with valid credentials. Saves accessToken/refreshToken/userId as collection variables for use by every other request in this repo.",
          "type": "text/plain"
        },
        "url": {
          "path": [
            "auth",
            "login"
          ],
          "host": [
            "{{baseUrl}}"
          ],
          "query": [],
          "variable": []
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"emilys\",\n  \"password\": \"emilyspass\",\n  \"expiresInMins\": 60\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "56ec67ad-f825-46de-9b1b-2aa79172124d",
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "    const body = pm.response.json();",
              "    pm.collectionVariables.set('accessToken', body.accessToken);",
              "    pm.collectionVariables.set('refreshToken', body.refreshToken);",
              "    pm.collectionVariables.set('userId', body.id);",
              "    pm.test('Login succeeded and tokens saved', () => {",
              "        pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
              "        pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
              "    });",
              "    pm.test('Response contains user data', () => {",
              "        pm.expect(body.username).to.eql('emilys');",
              "        pm.expect(body.email).to.be.a('string');",
              "        pm.expect(body.id).to.be.a('number');",
              "    });",
              "}",
              "pm.test(\"Response time is under 4000ms\", () => {",
              "    pm.expect(pm.response.responseTime).to.be.below(4000);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "id": "4f8be7d8-3665-4870-9351-478ae73e6d79",
      "name": "Login - Invalid Credentials",
      "request": {
        "description": {
          "content": "Attempt login with wrong credentials. Expected: 400.",
          "type": "text/plain"
        },
        "url": {
          "path": [
            "auth",
            "login"
          ],
          "host": [
            "{{baseUrl}}"
          ],
          "query": [],
          "variable": []
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"invalid_user\",\n  \"password\": \"wrong_password\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "6ad15924-dd74-4200-811d-d8d329b1bbd9",
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 400 for invalid credentials\", () => {",
              "    pm.expect(pm.response.code).to.eql(400);",
              "});",
              "pm.test(\"Error message present\", () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.message).to.be.a('string').and.not.empty;",
              "});",
              "pm.test(\"Response time is under 2000ms\", () => {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "id": "fb5b1cae-97ca-4d50-b987-cf0ae6d44301",
      "name": "Get Authenticated User",
      "request": {
        "description": {
          "content": "Fetch the authenticated user profile. A pre-request script decodes the stored access token's JWT exp claim and transparently re-authenticates if it's missing or expiring soon, so this request works standalone, not only after Login - Valid Credentials.",
          "type": "text/plain"
        },
        "url": {
          "path": [
            "auth",
            "me"
          ],
          "host": [
            "{{baseUrl}}"
          ],
          "query": [],
          "variable": []
        },
        "header": [
          {
            "description": {
              "content": "Auto-populated after running Login - Valid Credentials (var: accessToken)",
              "type": "text/plain"
            },
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "method": "GET"
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "id": "953f935c-3548-424d-876f-992034be1d33",
            "type": "text/javascript",
            "exec": [
              "function decodeJwtExp(token) {",
              "    try {",
              "        return JSON.parse(atob(token.split('.')[1])).exp;",
              "    } catch (e) {",
              "        return null;",
              "    }",
              "}",
              "",
              "const existingToken = pm.collectionVariables.get('accessToken');",
              "const existingUserId = pm.collectionVariables.get('userId');",
              "const nowSeconds = Math.floor(Date.now() / 1000);",
              "const bufferSeconds = 60;",
              "const exp = existingToken ? decodeJwtExp(existingToken) : null;",
              "const needsReauth = !existingToken || !existingUserId || !exp || (exp - nowSeconds) < bufferSeconds;",
              "",
              "if (needsReauth) {",
              "    pm.sendRequest({",
              "        url: pm.variables.get('baseUrl') + '/auth/login',",
              "        method: 'POST',",
              "        header: { 'Content-Type': 'application/json' },",
              "        body: {",
              "            mode: 'raw',",
              "            raw: JSON.stringify({ username: 'emilys', password: 'emilyspass', expiresInMins: 60 }),",
              "        },",
              "    }, (err, res) => {",
              "        if (!err && res.code === 200) {",
              "            const body = res.json();",
              "            pm.collectionVariables.set('accessToken', body.accessToken);",
              "            pm.collectionVariables.set('refreshToken', body.refreshToken);",
              "            pm.collectionVariables.set('userId', body.id);",
              "        }",
              "    });",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "id": "d5040ee9-6159-4400-9d18-7f2eef8ea71f",
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 200 with user profile\", () => {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Profile has required fields', () => {",
              "    pm.expect(body.id).to.be.a('number');",
              "    pm.expect(body.username).to.be.a('string').and.not.empty;",
              "    pm.expect(body.email).to.be.a('string').and.not.empty;",
              "});",
              "pm.test(\"Response time is under 2000ms\", () => {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "id": "9d5255c4-a8b1-40fe-9641-91aeed00bb0f",
      "name": "Get Authenticated User - Invalid Token",
      "request": {
        "description": {
          "content": "Call /auth/me with a deliberately invalid Bearer token. Expected: 401.",
          "type": "text/plain"
        },
        "url": {
          "path": [
            "auth",
            "me"
          ],
          "host": [
            "{{baseUrl}}"
          ],
          "query": [],
          "variable": []
        },
        "header": [
          {
            "description": {
              "content": "Deliberately invalid token",
              "type": "text/plain"
            },
            "key": "Authorization",
            "value": "Bearer this-is-not-a-valid-token"
          }
        ],
        "method": "GET"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "c96e11a4-f62c-411a-bb4f-259010a62b58",
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 401 for invalid auth token\", () => {",
              "    pm.expect(pm.response.code).to.eql(401);",
              "});",
              "pm.test(\"Error message present\", () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.message).to.be.a('string').and.not.empty;",
              "});",
              "pm.test(\"Response time is under 2000ms\", () => {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "id": "02f2c16b-9bc2-43e2-ac11-6ec283a574ad",
      "name": "Refresh Token",
      "request": {
        "description": {
          "content": "Exchange a refresh token for a new access token. Run Login - Valid Credentials first to populate {{refreshToken}}. Updates the stored tokens.",
          "type": "text/plain"
        },
        "url": {
          "path": [
            "auth",
            "refresh"
          ],
          "host": [
            "{{baseUrl}}"
          ],
          "query": [],
          "variable": []
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\",\n  \"expiresInMins\": 60\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "9a89eaf6-680b-48af-b7d2-762e6716d044",
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 200 with new tokens\", () => {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('New tokens are strings', () => {",
              "    pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
              "    pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
              "});",
              "if (pm.response.code === 200) {",
              "    const body = pm.response.json();",
              "    pm.collectionVariables.set('accessToken', body.accessToken);",
              "    pm.collectionVariables.set('refreshToken', body.refreshToken);",
              "}",
              "pm.test(\"Response time is under 2000ms\", () => {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "event": [],
  "variable": [],
  "info": {
    "_postman_id": "e61fea46-55e8-4f8a-ad6b-56f163987a67",
    "name": "auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Authentication endpoints: login, get current user, refresh token. The login request stores accessToken/refreshToken/userId as collection variables — every other collection in this repo depends on it running first.",
      "type": "text/plain"
    }
  }
}
