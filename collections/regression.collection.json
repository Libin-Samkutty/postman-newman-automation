          "name": "Create User",
          "request": {
            "description": {
              "content": "Create a new user. firstName/lastName/email come from --iteration-data (see data/users.csv) when run data-driven, or a timestamp-based fallback otherwise, so repeat runs don't collide. DummyJSON simulates the creation and assigns a server-side id.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "users",
                "add"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"{{dynamicFirstName}}\",\n  \"lastName\": \"{{dynamicLastName}}\",\n  \"email\": \"{{dynamicEmail}}\",\n  \"age\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "id": "518d3cb8-2f2e-4bc2-b9cb-80b90e883f39",
                "type": "text/javascript",
                "exec": [
                  "const timestamp = Date.now();",
                  "// Falls back to timestamp-based generation on a plain run; picks up",
                  "// per-row values automatically when run with --iteration-data (see data/users.csv).",
                  "pm.variables.set('dynamicFirstName', pm.iterationData.get('firstName') || `Test_${timestamp}`);",
                  "pm.variables.set('dynamicLastName', pm.iterationData.get('lastName') || 'Automation');",
                  "pm.variables.set('dynamicEmail', pm.iterationData.get('email') || `testuser_${timestamp}@healthsaas.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "id": "662d46ef-8e1e-4f06-965a-ad7980406e6a",
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Returns 201 with created user\", () => {",
                  "    pm.expect(pm.response.code).to.eql(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Created user has server-assigned id', () => {",
                  "    pm.expect(body.id).to.be.a('number');",
                  "});",
                  "pm.collectionVariables.set('createdUserId', body.id);",
                  "pm.test(\"Response time is under 2000ms\", () => {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ]
              }
            }
          ]
